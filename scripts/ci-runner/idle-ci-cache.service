[Unit]
Description=Persistent shared CI build cache
After=network.target

[Service]
Type=simple
Slice=idle-ci.slice
ExecStart=%h/.local/share/codex-ci-runner/bin/bazel-remote --dir /mnt/hot/ci-cache/bazel --max_size 512 --http_address 127.0.0.1:18500 --grpc_address none
Environment=GOMAXPROCS=4
Restart=on-failure
RestartSec=5
CPUQuota=400%
CPUWeight=20
MemoryHigh=1536M
MemoryMax=2G
MemorySwapMax=0
IOWeight=20
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
